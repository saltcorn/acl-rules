{
  "name": "@saltcorn/acl-rules",
  "version": "0.0.1",
  "description": "Access control plugin based on (Subject, Object, Verb, [Adjectives]) rules",
  "main": "index.js",
  "dependencies": {
    "@saltcorn/markup": "^0.9.0",
    "@saltcorn/data": "^0.9.0"
  },
  "author": "Christian Hugo",
  "license": "MIT",
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "repository": "github:saltcorn/acl-rules",
  "jest": {
    "testEnvironment": "node"
  },
  "scripts": {
    "test": "jest"
  },
  "eslintConfig": {
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaVersion": 2020
    },
    "env": {
      "node": true,
      "es6": true
    },
    "rules": {
      "no-unused-vars": "off",
      "no-case-declarations": "off",
      "no-empty": "warn",
      "no-fallthrough": "warn"
    }
  }
}
